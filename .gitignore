# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Do NOT push: secrets, build outputs, dependencies, or local artifacts.

# ============================================
# Dependencies — do not push
# ============================================
node_modules/
.pnpm-store/

# ============================================
# Next.js — do not push
# ============================================
.next/
out/
build/

# ============================================
# Environment & secrets — do not push
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# Keep .env.example in repo (template for developers)
!.env.example

# ============================================
# Debug & logs — do not push
# ============================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ============================================
# IDE & OS — do not push
# ============================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================
# Vercel — do not push
# ============================================
.vercel

# ============================================
# TypeScript — do not push
# ============================================
*.tsbuildinfo
next-env.d.ts

# ============================================
# CRE workflow (cre-intent) — do not push build artifacts
# ============================================
/cre-intent/node_modules
/cre-intent/tmp.js
/cre-intent/tmp.wasm

# ============================================
# Deploy artifacts (optional: remove to commit addresses for frontend)
# ============================================
contracts-deployed-base-sepolia.json
sol/contracts-deployed-base-sepolia.json

# ============================================
# sol/ — contracts subproject
# ============================================
sol/node_modules/
sol/.env
sol/cache/
sol/artifacts/
