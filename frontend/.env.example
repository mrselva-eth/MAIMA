# Required: WalletConnect project ID (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Required: AI API key for intent parsing (OpenRouter or OpenAI)
AI_API_KEY=

# Optional: Override AI model (default: openai/gpt-4o-mini)
# AI_MODEL=openai/gpt-4o-mini

# LI.FI API key lives in cre/cre-swap/config.staging.json and cre/cre-bridge/config.staging.json
# Copy from config.staging.example.json and fill lifiApiKey

CRE_CLI_PATH=bin/cre.exe
