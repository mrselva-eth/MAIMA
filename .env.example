# MAIMA Environment Variables
# Copy this file to .env or .env.local and fill in your values.
# Do not commit .env or .env.local — they are in .gitignore.

# ============================================
# WALLET CONNECTION (Required)
# ============================================
# Get your Project ID from WalletConnect Cloud: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# ============================================
# AI INTEGRATION (Required for intent parsing)
# ============================================
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# OpenRouter (alternative for intent parsing): https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================
# API CONFIGURATION (Optional)
# ============================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ============================================
# UNISWAP (Optional — DEX quotes)
# ============================================
NEXT_PUBLIC_UNISWAP_ROUTER_ADDRESS=0x68b3465833fb72B5A828cCEDA8EA15E0AD9CA37d

# ============================================
# CHAINLINK CRE (Optional)
# ============================================
# For CRE workflow execution; only set if deploying CRE workflows
# CRE_ETH_PRIVATE_KEY=your_eth_private_key_here

# ============================================
# RPC ENDPOINTS (Optional)
# ============================================
# NEXT_PUBLIC_RPC_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_RPC_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
